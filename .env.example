# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Shopify
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Shopify webhook secret (от Settings → Notifications → Webhooks)
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret

# JWT
JWT_SECRET=super_secret_key_min_32_chars_long_random_string

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_strong_password

# Microsoft Graph API (Azure Entra ID)
# Виж README – "Настройка на Azure App Registration"
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your_client_secret_value
# Мейл адресът, ОТ който се изпращат нотификациите (трябва да е M365 mailbox)
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=RealFood Influencer Portal

# URL на портала (за линка в мейла)
NEXT_PUBLIC_PORTAL_URL=https://your-portal.vercel.app

# Имейл за admin нотификации (заявки за изплащане)
ADMIN_NOTIFY_EMAIL=pavel@realfood.bg

# Базов URL на онлайн магазина (за discount линковете)
SHOP_BASE_URL=https://realfood.bg

# Cron защита (генерирай случаен стринг)
CRON_SECRET=random_cron_secret_here
